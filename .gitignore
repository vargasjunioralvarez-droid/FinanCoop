@'
# ============================================
# PYTHON (Backend)
# ============================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
env.bak/
venv.bak/
backend/venv/
backend/__pycache__/
*.pyc
backend/*.db
backend/financash.db

# ============================================
# NODE.JS (Frontend/Mobile)
# ============================================
node_modules/
**/node_modules/
dist/
build/
*.local
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ============================================
# CAPACITOR - ANDROID
# Ignorar SOLO archivos generados, NO configuración
# ============================================
# Build outputs
mobile/android/app/build/
mobile/android/build/
mobile/android/capacitor-cordova-android-plugins/build/
mobile/android/.gradle/
mobile/android/gradle/
mobile/android/gradlew
mobile/android/gradlew.bat
mobile/android/local.properties
mobile/android/app/release/
mobile/android/app/debug/
mobile/android/**/*.iml
mobile/android/.idea/
mobile/android/captures/
mobile/android/externalNativeBuild/
mobile/android/.cxx/

# iOS
mobile/ios/App/build/
mobile/ios/App/Pods/
mobile/ios/App/Podfile.lock
mobile/ios/App/App.xcworkspace/
mobile/ios/App/App.xcodeproj/xcuserdata/
mobile/ios/App/App.xcodeproj/project.xcworkspace/

# ============================================
# IDE / OS
# ============================================
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# ============================================
# ENV / SECRETS
# ============================================
.env
.env.local
.env.*.local
key.properties
*.keystore
*.jks
google-services.json

# ============================================
# TESTING
# ============================================
coverage/
.pytest_cache/

# ============================================
# OTROS
# ============================================
*.tmp
*.temp
.cache/
dev-dist/
dist-ssr/
'@ | Out-File -FilePath ".gitignore" -Encoding utf8
# Android generated files
mobile/android/.gitignore
mobile/android/app/src/androidTest/
mobile/android/app/src/test/
mobile/android/dependencies.txt
